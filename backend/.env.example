# Copy to backend/.env and adjust.
# - POSTGRES_* are read by docker-compose to provision the postgres service.
# - The application reads MINDOCU_* settings (prefix MINDOCU_, nested fields
#   use a double underscore, e.g. MINDOCU_SEGMENTATION__PROVIDER__MODEL).
# Keep MINDOCU_DATABASE_URL consistent with the POSTGRES_* values below.

# --- Postgres service (docker-compose) ---
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...
POSTGRES_PORT=5432

# --- Application ---
MINDOCU_DATABASE_URL=postgresql+psycopg://mindocu:mindocu@localhost:5432/mindocu
MINDOCU_STORAGE_DIR=data/pdfs
MINDOCU_MAX_PDFS_PER_CASE=3

# --- Pipeline: stage 2 (segmentation) ---
# Strategy plus its own LLM backend. Default backend is MLX (Apple Silicon,
# in-process).
MINDOCU_SEGMENTATION__STRATEGY=full_context
MINDOCU_SEGMENTATION__PROVIDER__BACKEND=mlx
MINDOCU_SEGMENTATION__PROVIDER__MODEL=mlx-community/Qwen3.6-35B-A3B-4bit

# For Ollama instead, full_context needs num_ctx (the default truncates):
# MINDOCU_SEGMENTATION__PROVIDER__BACKEND=ollama
# MINDOCU_SEGMENTATION__PROVIDER__MODEL=qwen3:30b
# MINDOCU_SEGMENTATION__PROVIDER__NUM_CTX=131072

# --- Pipeline: stage 3 (enrichment) ---
# Its own LLM backend, independent of segmentation's (defaults to MLX too).
MINDOCU_ENRICHMENT__PROVIDER__BACKEND=mlx
MINDOCU_ENRICHMENT__PROVIDER__MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
MINDOCU_ENRICHMENT__ENRICH_IRRELEVANT=false

# Used by the API tests (testcontainers spins one up if unset):
# TEST_DATABASE_URL=postgresql+psycopg://mindocu:mindocu@localhost:5432/mindocu_test
